# MongoDB
MONGODB_URI=
MONGO_URI=

# Redis (Upstash - Use REST API endpoints)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# JWT Secret (REQUIRED in production - use strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMTP Configuration (for email verification)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration (comma-separated origins for production)
# Example: CORS_ORIGIN=https://yourapp.com,https://www.yourapp.com
CORS_ORIGIN=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Logging
LOG_LEVEL=info
