# ============================================
# AZURE PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy these to Azure Portal → Configuration → Application settings
# DO NOT commit actual values to git!

# ============================================
# REQUIRED - App will fail to start without these
# ============================================

# Environment (CRITICAL - must be "production")
NODE_ENV=production

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/hackmate?retryWrites=true&w=majority

# Upstash Redis (REST API - NOT redis:// protocol)
UPSTASH_REDIS_REST_URL=https://gusc1-informal-possum-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AYKSASQgNjQyYmYwNDAtZjI2Yy00MGQ0LWI3OWMtNDFhZGE0NTU3MWJixxxxxxxxxxxx

# JWT Secret (Generate: openssl rand -base64 32)
JWT_SECRET=XyZ9k2mN5pQ8rT1vW4bC6dF3gH7jK0lM2nP5qS8tU1wX4yZ7aC9bD2eF5gH8j

# CORS Origins (comma-separated, no spaces)
CORS_ORIGIN=https://hackmate.app,https://www.hackmate.app,https://cli.hackmate.app

# ============================================
# OPTIONAL - Email functionality
# ============================================

# Gmail SMTP (use App Password, not regular password)
SMTP_USER=your-email@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# ============================================
# OPTIONAL - Configuration overrides
# ============================================

# Server (Azure auto-sets PORT, usually don't need to set)
# PORT=8080
# HOST=0.0.0.0

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Logging
LOG_LEVEL=info

# ============================================
# OPTIONAL - Azure Application Insights
# ============================================

# Application Insights (to stop warnings in logs)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx;IngestionEndpoint=https://centralindia-1.in.applicationinsights.azure.com/

# ============================================
# NOTES
# ============================================
# 
# How to add in Azure Portal:
# 1. Go to: Azure Portal → hackmateserver → Configuration
# 2. Click: Application settings → New application setting
# 3. Add each variable as: Name = VALUE
# 4. Click Save at the top
#
# Security Notes:
# - Never use default/example values in production
# - JWT_SECRET must be 32+ random characters
# - Use MongoDB Atlas IP whitelist (add Azure IPs)
# - Use Upstash Redis REST URLs (not redis:// protocol)
# - CORS_ORIGIN should only include your actual domains
#
# Testing Locally with Production Settings:
# NODE_ENV=production MONGO_URI=... JWT_SECRET=... npm start
#
